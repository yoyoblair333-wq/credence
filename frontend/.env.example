# GenLayer RPC API URL
# Default: https://studio.genlayer.com/api
# Use this default for the hosted Studio, or your own GenLayer node URL for local development.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer Network Configuration
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Credence Intelligent Contract address
# This is the address returned when you deploy credence.py (class Credence) to
# GenLayer. It is intentionally left EMPTY by default — with no address set, the
# UI runs in a read-only DEMO/PREVIEW mode: it shows representative mock data and
# a clear banner so you can explore the whole product, and never crashes. Do not
# invent an address.
# Example: NEXT_PUBLIC_CREDENCE_CONTRACT_ADDRESS=0x1234...abcd
NEXT_PUBLIC_CREDENCE_CONTRACT_ADDRESS=

# Legacy / fallback variable. Only used if the variable above is unset.
# Leave empty unless you are pointing the UI at an older deployment.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Public repository URL (optional). When set, the Governance card links to the
# in-repo spec at <repo>/blob/main/docs/GOVERNANCE.md. Leave empty and the card
# simply names the file instead of rendering a dead link.
# Example: NEXT_PUBLIC_REPO_URL=https://github.com/your-org/credence
NEXT_PUBLIC_REPO_URL=
