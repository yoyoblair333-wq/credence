{
  "name": "@credence/sdk",
  "version": "1.4.0",
  "description": "Typed, framework-agnostic integration SDK for the Credence GenLayer protocol — reputation-underwritten, undercollateralized credit. Referral: JTR01FHP",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "genlayer",
    "credence",
    "credit",
    "defi",
    "undercollateralized",
    "oracle",
    "sdk",
    "intelligent-contract"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "genlayer-js": "^1.1.8"
  },
  "peerDependenciesMeta": {
    "genlayer-js": {
      "optional": false
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
